{
  "name": "parlo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @parlo/web",
    "build": "npm run build -w @parlo/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:lint": "tsx scripts/south-lint-content.ts",
    "audio:list": "tsx scripts/audio/recording-list.ts",
    "audio:process": "tsx scripts/audio/process.ts",
    "audio:e2e": "tsx scripts/audio/synth-fixtures.ts --e2e",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "check": "npm run typecheck && npm run test && npm run content:validate && npm run content:lint && npm run i18n:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
