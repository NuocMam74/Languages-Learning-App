# Copier en `.env` à la racine du dépôt. Lu par l'API (apps/api) et par docker compose.

# --- API ---------------------------------------------------------------------------------
# Obligatoire hors développement : longue chaîne aléatoire (ex. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
JWT_SECRET=dev-insecure-change-me-dev-insecure-change-me
# Défaut : SQLite apps/api/parlo.db (dev sans Docker). docker compose fixe sa propre URL PostgreSQL.
# Prod : PostgreSQL via psycopg 3 :
# DATABASE_URL=postgresql+psycopg://parlo:parlo@localhost:5432/parlo
# Durées de vie des jetons
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# `false` uniquement en développement http local (le cookie de refresh doit être Secure en prod).
COOKIE_SECURE=false
# Limitation /auth/* : requêtes par IP et par route sur la fenêtre (secondes)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60

# --- Contenu ------------------------------------------------------------------------------
# Dossier des packs, chemin absolu (défaut : content/ du dépôt ; /content dans compose)
# CONTENT_DIR=/chemin/vers/content
# Gabarit d'URL du manifeste ; {code} et {version} sont substitués. En prod : URL du CDN,
# ex. https://cdn.parlo.app/content/{code}/v{version}/  (défaut : /content/{code}/v{version}/)
# CONTENT_BASE_URL=
# Sert CONTENT_DIR en statique sous /content/{code}/v{version}/ (dev)
SERVE_CONTENT=true
DEFAULT_COURSE=vi-south

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173
# Préfixe sous lequel un proxy expose l'API (ex. /api) : root_path FastAPI + chemin du cookie de refresh (/api/auth).
# Vide si l'API est appelée directement (VITE_API_BASE pointant sur son origine).
# ROOT_PATH=/api

# --- Professeur IA (Phase 1) -------------------------------------------------------------
# Sans clé, /tutor/* répond avec des messages préécrits (source: "fallback").
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-4-6
# Appels au modèle par utilisateur et par jour UTC (une régénération « garde du Sud » compte)
TUTOR_DAILY_QUOTA=30
# Requêtes /tutor/* par utilisateur sur la fenêtre (secondes)
TUTOR_RATE_LIMIT=10
TUTOR_RATE_WINDOW_SECONDS=60
# Délai d'un appel au modèle avant repli (secondes)
TUTOR_TIMEOUT_SECONDS=15
# Purge glissante de tutor_messages (python -m app.maintenance purge-tutor)
TUTOR_RETENTION_DAYS=90

# --- Phase 2 : certificats, défis, notifications -----------------------------------------
# URL publique de la PWA : lien imprimé sur les certificats ({PUBLIC_WEB_URL}/verifier/{code})
PUBLIC_WEB_URL=http://localhost:5173
# Rendu PDF : auto (WeasyPrint si Pango est installé, sinon fpdf2 pur Python) | weasyprint | fpdf2
PDF_RENDERER=auto
# Stockage des PDF : local (MEDIA_DIR, défaut apps/api/media) | s3 (compatible S3 via boto3 ;
# identifiants par la chaîne standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
STORAGE_BACKEND=local
# MEDIA_DIR=/chemin/vers/media
# S3_BUCKET=
# S3_PREFIX=certificates/
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# Tâches planifiées intégrées (défi du lundi 00:00 UTC, rappels push horaires) : un seul processus à true
SCHEDULER_ENABLED=false
# Web Push (VAPID) : `uv run python -m app.maintenance vapid-keys` (apps/api) génère la paire
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@parlo.app
