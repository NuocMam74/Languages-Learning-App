{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlo.app/schema/placement.schema.json",
  "title": "Mini-test de placement (spec §4.1.4)",
  "description": "Items adaptatifs, audio seul. Ne référence que des concepts existants du pack.",
  "type": "object",
  "required": ["pack", "durationSeconds", "slots", "items", "levels", "reviewed"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "pack": { "type": "string" },
    "durationSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
    "slots": {
      "description": "Compétence évaluée à chaque position du test, dans l'ordre.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/skill" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "difficulty", "concept"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p[tcv]_[a-z0-9_]+$" },
          "skill": { "$ref": "#/$defs/skill" },
          "difficulty": { "enum": [1, 2, 3] },
          "concept": { "$ref": "common.schema.json#/$defs/conceptId" },
          "distractors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/conceptId" }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "minScore"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "integer", "minimum": 0, "maximum": 3 },
          "minScore": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "reviewed": { "$ref": "common.schema.json#/$defs/reviewed" }
  },
  "$defs": {
    "skill": { "enum": ["tone", "comprehension", "vocab"] }
  }
}
