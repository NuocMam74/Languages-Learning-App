{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlo.app/schema/game-xe-om.schema.json",
  "title": "Mini-jeu Xe ôm : cartes et itinéraires",
  "description": "Cartes stylisées en grille (rues sur les lignes, pâtés de maisons entre elles) et itinéraires dictés consigne par consigne. La cohérence (itinéraire dans la grille, repère au bon carrefour, arrêt final) est vérifiée par checkXeOmData.",
  "type": "object",
  "required": ["version", "maps", "routes", "reviewed"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "maps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/map" } },
    "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
    "reviewed": { "$ref": "common.schema.json#/$defs/reviewed" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "cell": {
      "description": "[x, y] : x vers l'est, y vers le sud, à partir de 0.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 11 }
    },
    "heading": { "enum": ["N", "E", "S", "W"] },
    "icon": { "enum": ["market", "school", "hospital", "pagoda", "cafe", "pho", "park", "station", "gas"] },
    "map": {
      "type": "object",
      "required": ["id", "cols", "rows", "canals", "landmarks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cols": { "type": "integer", "minimum": 3, "maximum": 8, "description": "Carrefours par rangée (rues verticales)." },
        "rows": { "type": "integer", "minimum": 3, "maximum": 10, "description": "Carrefours par colonne (rues horizontales)." },
        "canals": {
          "description": "Pâtés occupés par un canal (décor ; les rues qui les traversent sont des ponts).",
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "landmarks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/landmark" } }
      }
    },
    "landmark": {
      "type": "object",
      "required": ["id", "block", "vi", "gloss", "icon"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "block": { "$ref": "#/$defs/cell", "description": "Pâté de maisons ; ses 4 coins sont les carrefours voisins du repère." },
        "vi": { "$ref": "common.schema.json#/$defs/viText" },
        "gloss": { "$ref": "common.schema.json#/$defs/localized" },
        "concept": { "$ref": "common.schema.json#/$defs/conceptId" },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "map", "level", "start", "instructions", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "map": { "$ref": "#/$defs/id" },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "start": {
          "type": "object",
          "required": ["at", "heading"],
          "additionalProperties": false,
          "properties": { "at": { "$ref": "#/$defs/cell" }, "heading": { "$ref": "#/$defs/heading" } }
        },
        "concepts": {
          "description": "Concepts entraînés (facultatif) : aide à choisir l'itinéraire d'une leçon.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/conceptId" }
        },
        "instructions": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "$ref": "#/$defs/instruction" } },
        "reviewed": { "$ref": "common.schema.json#/$defs/reviewed" }
      }
    },
    "instruction": {
      "type": "object",
      "required": ["vi", "action", "gloss"],
      "additionalProperties": false,
      "properties": {
        "vi": { "$ref": "common.schema.json#/$defs/viText", "description": "Consigne orale du chauffeur, en parler du Sud (quẹo de préférence, rẽ accepté)." },
        "action": {
          "enum": ["left", "right", "straight", "stop"],
          "description": "Au carrefour courant : tourner (puis rouler jusqu'au carrefour suivant), tout droit, ou s'arrêter."
        },
        "landmark": { "$ref": "#/$defs/id", "description": "Repère nommé : il doit toucher le carrefour où l'action a lieu." },
        "gloss": { "$ref": "common.schema.json#/$defs/localized" },
        "audio": { "$ref": "common.schema.json#/$defs/mediaPath" }
      }
    }
  }
}
