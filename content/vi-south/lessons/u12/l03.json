      }
    },
    {
      "type": "tone_identify",
      "concept": "c_vi_because",
      "explain": {
        "fr": "vì descend (huyền).",
        "en": "vì falls (huyền)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Tại sao em học tiếng Việt?",
