{
  "$schema": "../../../schema/lesson.schema.json",
  "id": "vi-south.u12.l01",
  "unit": "vi-south.u12",
  "title": {
    "fr": "Ai ? Gì ?",
    "en": "Who? What?"
  },
  "goal": {
    "fr": "Demander qui et quoi.",
    "en": "Ask who and what."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u09.l08"
  ],
  "concepts": [
    "s_cai_gi_vay",
    "s_nguoi_do_la_ai",
    "s_em_an_gi",
    "c_hoi_ask",
    "c_tra_loi",
    "c_bac_si",
    "c_giao_vien",
    "c_sinh_vien"
  ],
  "steps": [
    {
      "type": "listen_pick_text",
      "concept": "s_cai_gi_vay",
      "distractors": [
        "Cái này vậy?",
        "Ai vậy?"
      ],
      "explain": {
        "fr": "Cái gì vậy ? : c'est quoi ? gì = quoi.",
        "en": "Cái gì vậy?: what's that? gì = what."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_question_word_end"
    },
    {
      "type": "listen_pick_text",
      "concept": "s_nguoi_do_la_ai",
      "distractors": [
        "Người đó là anh.",
        "Người này là ai?"
      ],
      "explain": {
        "fr": "ai = qui. đó : là-bas ; này : ici.",
        "en": "ai = who. đó: over there; này: here."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_bac_si",
      "distractors": [
        "c_giao_vien",
        "c_sinh_vien"
      ],
      "explain": {
        "fr": "Người đó là ai ? — Bác sĩ : le médecin.",
        "en": "Người đó là ai? — Bác sĩ: the doctor."
      }
    },
    {
      "type": "build_sentence",
      "target": "Người đó là ai?",
      "tokens": [
        "Người",
        "đó",
        "là",
        "ai",
        "gì"
      ],
      "translation": {
        "fr": "Qui est cette personne ?",
        "en": "Who is that person?"
      },
      "explain": {
        "fr": "ai prend la place de la réponse : Người đó là chị Lan.",
        "en": "ai takes the answer's place: Người đó là chị Lan."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_em_an_gi",
      "distractors": [
        "Em ăn gà?",
        "Em uống gì?"
      ],
      "explain": {
        "fr": "ăn gì : manger quoi. uống gì : boire quoi.",
        "en": "ăn gì: eat what. uống gì: drink what."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_tra_loi",
      "distractors": [
        "trả lại",
        "tra lời"
      ],
      "explain": {
        "fr": "trả lời : répondre. trả lại : rendre.",
        "en": "trả lời: to answer. trả lại: to give back."
      }
    },
    {
      "type": "fill_gap",
      "text": "Người đó là ai ___?",
      "answer": "vậy",
      "options": [
        "vậy",
        "vây",
        "vẫy"
      ],
      "translation": {
        "fr": "C'est qui, cette personne ?",
        "en": "Who is that person?"
      },
      "explain": {
        "fr": "vậy en fin de question adoucit : très courant au Sud.",
        "en": "vậy at the end of a question softens it: very common in the South."
      }
    },
    {
      "type": "tone_produce",
      "concept": "c_hoi_ask",
      "explain": {
        "fr": "hỏi : la voix plonge puis remonte un peu.",
        "en": "hỏi: the voice dips then rises a little."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_cai_gi_vay",
      "explain": {
        "fr": "cái monte, gì descend, vậy tombe court.",
        "en": "cái rises, gì falls, vậy drops short."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_hoi_ask",
      "distractors": [
        "rưỡi",
        "ổng",
        "thôi"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_giao_vien",
      "distractors": [
        "sinh viên",
        "công viên"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_sinh_vien",
      "distractors": [
        "trả lời",
        "gia đình"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_bac_si",
      "distractors": [
        "xin lỗi",
        "xe máy"
      ]
    },
    {
      "type": "listen_pick_image",
      "concept": "c_giao_vien",
      "distractors": [
        "c_chi_hai",
        "c_bac_si",
        "c_thom"
      ]
    },
    {
      "type": "listen_pick_image",
      "concept": "c_sinh_vien",
      "distractors": [
        "c_sua_milk",
        "c_xoai",
        "c_com_tam"
      ]
    },
    {
      "type": "build_sentence",
      "target": "Người đó là ai vậy",
      "tokens": [
        "Người",
        "đó",
        "là",
        "ai",
        "vậy"
      ],
      "translation": {
        "fr": "C'est qui, cette personne ?",
        "en": "Who is that person?"
      },
      "audioConcept": "s_nguoi_do_la_ai"
    },
    {
      "type": "match_pairs",
      "concepts": [
        "s_cai_gi_vay",
        "s_nguoi_do_la_ai",
        "s_em_an_gi",
        "c_hoi_ask",
        "c_tra_loi",
        "c_bac_si"
      ]
    }
  ],
  "review": {
