      "type": "spot_the_south",
      "variant": "lv_de_rien",
      "explain": {
        "fr": "Sud : không có chi.",
        "en": "South: không có chi."
      }
    },
    {
      "type": "build_sentence",
      "target": "Nè, coi cái này nè!",
