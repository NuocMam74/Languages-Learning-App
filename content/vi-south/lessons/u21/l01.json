        "c_ba_she"
      ],
      "explain": {
        "fr": "bà descend : grand-mère. bả plonge : elle.",
        "en": "bà falls: grandmother. bả dips: she."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_ba_ay",
      "explain": {
        "fr": "Sud, à l'oral : bả ; ailleurs : bà ấy.",
        "en": "Spoken South: bả; elsewhere: bà ấy."
      }
    },
    {
      "type": "fill_gap",
      "text": "___ đi đâu rồi?",
      "answer": "Ổng",
      "options": [
        "Ổng",
        "Ông",
        "Ống"
      ],
      "translation": {
        "fr": "Il est parti où ? (un homme âgé)",
        "en": "Where has he gone? (an older man)"
      },
      "explain": {
        "fr": "ổng = ông ấy contracté, à l'oral au Sud. Ống = un tuyau.",
        "en": "ổng is a contraction of ông ấy in Southern speech. Ống = a pipe."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_anh_ay",
      "explain": {
