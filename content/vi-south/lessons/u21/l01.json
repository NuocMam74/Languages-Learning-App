      ],
      "explain": {
        "fr": "ông reste plat ; ổng plonge.",
        "en": "ông stays level; ổng dips."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_ong_ay",
      "explain": {
        "fr": "Sud, à l'oral : ổng ; ailleurs : ông ấy.",
        "en": "Spoken South: ổng; elsewhere: ông ấy."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
