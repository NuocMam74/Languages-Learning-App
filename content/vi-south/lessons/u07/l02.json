      "concept": "s_ca_phe_sua_da",
      "distractors": [
        "s_tra_da",
        "c_sua_milk"
      ],
      "explain": {
        "fr": "cà phê sữa đá : café, lait concentré, glace.",
        "en": "cà phê sữa đá: coffee, condensed milk, ice."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_ca_phe_sua_da"
    },
    {
      "type": "tone_identify",
      "concept": "c_da_ice",
      "explain": {
