        "s_ca_phe_sua_da"
      ],
      "explain": {
        "fr": "cà phê : le café, ici dans son phin.",
        "en": "cà phê: coffee, here in its phin filter."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_nuoc_mia",
      "distractors": [
        "nước mìa",
        "nước mắm"
      ],
      "explain": {
        "fr": "nước mía : le jus de canne. mía monte.",
        "en": "nước mía: sugarcane juice. mía rises."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_ly",
      "distractors": [
        "c_to_bowl",
        "c_sua_milk"
