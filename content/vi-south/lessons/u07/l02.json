        "en": "ly: glass, in the South."
      }
    },
    {
      "type": "build_sentence",
      "target": "Cho em một ly cà phê sữa đá.",
      "tokens": [
        "Cho",
        "em",
        "một",
        "ly",
        "cà phê",
        "sữa",
        "đá",
        "tô"
      ],
      "translation": {
        "fr": "Un café glacé au lait, s'il te plaît.",
        "en": "An iced milk coffee, please."
      },
      "explain": {
        "fr": "Pour une boisson : một ly + boisson.",
        "en": "For a drink: một ly + drink."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_verre",
      "explain": {
        "fr": "Sud : ly ; Nord : cốc.",
        "en": "South: ly; North: cốc."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_tra_da",
      "distractors": [
        "trà đà",
        "trà sữa"
      ],
      "explain": {
        "fr": "trà đá : le thé glacé. trà sữa : le thé au lait.",
        "en": "trà đá: iced tea. trà sữa: milk tea."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_ca_phe_sua_da",
      "explain": {
        "fr": "cà descend, phê plat, sữa plonge, đá monte.",
        "en": "cà falls, phê level, sữa dips, đá rises."
      }
    }
