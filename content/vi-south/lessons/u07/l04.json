{
  "$schema": "../../../schema/lesson.schema.json",
  "id": "vi-south.u07.l04",
  "unit": "vi-south.u07",
  "title": {
    "fr": "Commander au quán",
    "en": "Ordering at a quán"
  },
  "goal": {
    "fr": "Appeler le serveur, commander et dire que c'est bon.",
    "en": "Call the server, order and say it's good."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u07.l03"
  ],
  "concepts": [
    "s_em_oi",
    "c_mon",
    "c_cay",
    "c_it",
    "c_ngon",
    "s_ngon_qua",
    "c_b_hay",
    "c_them",
    "c_dua",
    "c_muong",
    "c_dia_plate",
    "c_chen",
    "c_nuoc_mia",
    "c_ly",
    "s_tra_da",
    "c_da_ice"
  ],
  "steps": [
    {
      "type": "listen_pick_text",
      "concept": "s_em_oi",
      "distractors": [
        "Anh ơi!",
        "Chị ơi!"
      ],
      "explain": {
        "fr": "em ơi : pour un serveur plus jeune.",
        "en": "em ơi: for a younger server."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_calling_waiter"
    },
    {
      "type": "listen_pick_text",
      "concept": "c_cay",
      "distractors": [
        "cày",
        "cây"
      ],
      "explain": {
        "fr": "cay, plat : piquant. cày descend : labourer.",
        "en": "cay, level: spicy. cày falls: to plough."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_mon",
      "explain": {
        "fr": "món monte (sắc) : le plat.",
        "en": "món rises (sắc): dish."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_ngon",
      "distractors": [
        "ngọn",
        "ngón"
      ],
      "explain": {
        "fr": "ngon, plat : bon. ngón monte : le doigt.",
        "en": "ngon, level: tasty. ngón rises: finger."
      }
    },
    {
      "type": "build_sentence",
      "target": "Em ơi, cho anh một tô hủ tiếu.",
      "tokens": [
        "Em ơi",
        "cho",
        "anh",
        "một",
        "tô",
        "hủ tiếu",
        "chén"
      ],
      "translation": {
        "fr": "S'il te plaît, un bol de hủ tiếu. (homme, à un serveur plus jeune)",
        "en": "Excuse me, a bowl of hủ tiếu. (man, to a younger server)"
      },
      "explain": {
        "fr": "Face à un serveur plus jeune, le client dit anh ou chị pour « je ».",
        "en": "With a younger server, the customer says anh or chị for 'I'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_it",
      "distractors": [
        "ịt",
        "ỉt"
      ],
      "explain": {
        "fr": "ít monte : peu.",
        "en": "ít rises: little."
      }
    },
    {
      "type": "dialogue_choice",
      "situation": {
        "fr": "Tu entres dans un quán à midi ; le serveur vient te voir.",
        "en": "You walk into a quán at lunchtime; the waiter comes over."
      },
      "turns": [
        {
          "id": "t1",
          "vi": "Dạ, anh ăn gì?",
          "translation": {
            "fr": "Vous prenez quoi ?",
            "en": "What will you have?"
          },
          "replies": [
            {
              "id": "r1a",
              "vi": "Cho anh một tô phở.",
              "next": "t2",
              "best": true,
              "feedback": {
                "fr": "Naturel : cho + pronom + quantité + plat.",
                "en": "Natural: cho + pronoun + quantity + dish."
              }
            },
            {
              "id": "r1b",
              "vi": "Tôi muốn phở.",
              "next": "t2",
              "feedback": {
                "fr": "Compréhensible, mais on dit plutôt « Cho anh một tô phở ».",
                "en": "Understandable, but 'Cho anh một tô phở' is what people say."
              }
            }
          ]
        },
        {
          "id": "t2",
          "vi": "Dạ, anh ăn cay hông?",
          "translation": {
            "fr": "Vous mangez pimenté ?",
            "en": "Do you eat spicy food?"
          },
          "replies": [
            {
              "id": "r2a",
              "vi": "Ít cay thôi nha em.",
              "next": "t3",
              "best": true,
              "feedback": {
                "fr": "« thôi » puis « nha » : la demande devient douce.",
                "en": "'thôi' then 'nha' softens the request."
              }
            },
            {
              "id": "r2b",
              "vi": "Không.",
              "next": "t3",
              "feedback": {
                "fr": "Un peu sec : au moins « Dạ hông ».",
                "en": "A bit blunt: at least say 'Dạ hông'."
              }
            },
            {
              "id": "r2c",
              "vi": "Dạ hông, cảm ơn em.",
              "next": "t3",
              "feedback": {
                "fr": "Correct et poli, mais tu passes à côté du piment !",
                "en": "Correct and polite, but you miss out on the chilli!"
              }
            }
          ]
        },
        {
          "id": "t3",
          "vi": "Dạ, anh chờ chút xíu nha.",
          "translation": {
            "fr": "Un petit instant.",
            "en": "Just a moment."
          },
          "replies": [
            {
              "id": "r3a",
              "vi": "Dạ, cảm ơn em.",
              "best": true,
              "feedback": {
                "fr": "« Dạ » garde le ton poli, même vers plus jeune.",
                "en": "'Dạ' keeps things polite, even to someone younger."
              }
            },
            {
              "id": "r3b",
              "vi": "Ừ, cảm ơn em.",
              "feedback": {
                "fr": "« Ừ » est un peu brusque face à quelqu'un qu'on ne connaît pas.",
                "en": "'Ừ' is a bit curt with someone you don't know."
              }
            }
          ]
        }
      ],
      "explain": {
        "fr": "Le bon choix est presque toujours celui qui ajoute dạ ou nha.",
        "en": "The right choice is nearly always the one that adds dạ or nha."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_ngon_qua",
      "distractors": [
        "Ngon lắm!",
        "Không ngon."
      ],
      "explain": {
        "fr": "Ngon quá ! : l'exclamation. Ngon lắm ! : « très bon ».",
        "en": "Ngon quá!: the exclamation. Ngon lắm!: 'very good'."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_ngon_qua",
      "explain": {
        "fr": "ngon plat, quá monte avec entrain.",
        "en": "ngon level, quá rises with enthusiasm."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_mon",
      "distractors": [
        "xa",
