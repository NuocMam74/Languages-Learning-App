      "type": "listen_pick_image",
      "concept": "c_chen",
      "distractors": [
        "c_dia_plate",
        "c_to_bowl"
      ],
      "explain": {
        "fr": "chén : le petit bol à riz.",
        "en": "chén: small rice bowl."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_chen_to_dia"
    },
    {
      "type": "listen_pick_image",
      "concept": "c_muong",
      "distractors": [
        "c_dua",
        "c_dia_plate"
      ],
      "explain": {
        "fr": "muỗng : la cuillère.",
        "en": "muỗng: spoon."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_bol",
      "explain": {
        "fr": "Sud : chén ; Nord : bát.",
        "en": "South: chén; North: bát."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_dua",
      "distractors": [
        "c_muong",
        "c_chen"
