      }
    },
    {
      "type": "build_sentence",
      "target": "Cho em thêm một cái chén.",
      "tokens": [
        "Cho",
        "em",
        "thêm",
        "một",
        "cái",
        "chén",
        "ly"
      ],
      "translation": {
        "fr": "Un bol de plus, s'il te plaît.",
        "en": "One more bowl, please."
      },
      "explain": {
        "fr": "thêm devant la quantité : « en plus ».",
        "en": "thêm before the quantity: 'extra'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_them",
      "distractors": [
        "thềm",
        "thệm"
      ],
      "explain": {
        "fr": "thêm, plat : en plus. thềm descend : le seuil.",
        "en": "thêm, level: extra. thềm falls: doorstep."
      }
    },
    {
      "type": "game",
