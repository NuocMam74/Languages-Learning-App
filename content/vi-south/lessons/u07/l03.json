  "title": {
    "fr": "Chén, dĩa, muỗng, đũa",
    "en": "Chén, dĩa, muỗng, đũa"
  },
  "goal": {
    "fr": "Nommer la vaisselle du Sud et en demander davantage.",
    "en": "Name southern tableware and ask for more."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u07.l02"
  ],
  "concepts": [
