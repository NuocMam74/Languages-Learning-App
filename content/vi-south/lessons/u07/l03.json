        "en": "đũa: chopsticks."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_dua",
      "explain": {
        "fr": "đũa porte le ngã : au Sud, il sonne comme un hỏi.",
        "en": "đũa carries ngã: in the South it sounds like hỏi."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_dia_plate",
      "distractors": [
        "dìa",
        "dịa"
