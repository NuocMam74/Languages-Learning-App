        "Em ơi, ít cay thôi."
      ],
      "explain": {
        "fr": "tính tiền : l'addition.",
        "en": "tính tiền: the bill."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_ngot",
      "explain": {
        "fr": "ngọt tombe court (nặng).",
        "en": "ngọt drops short (nặng)."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_nuoc_mam",
      "distractors": [
        "c_ot",
        "c_sua_milk"
      ],
      "explain": {
