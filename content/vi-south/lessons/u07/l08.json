      "explain": {
        "fr": "em ơi : serveur plus jeune.",
        "en": "em ơi: younger server."
      }
    },
    {
      "type": "build_sentence",
      "target": "Em ơi, cho anh một tô hủ tiếu.",
      "tokens": [
        "Em ơi",
        "cho",
        "anh",
        "một",
        "tô",
        "hủ tiếu",
        "chén"
      ],
      "translation": {
        "fr": "S'il te plaît, un bol de hủ tiếu. (homme, à un serveur plus jeune)",
        "en": "Excuse me, a bowl of hủ tiếu. (man, to a younger server)"
      },
      "explain": {
        "fr": "anh = « je » face à plus jeune.",
        "en": "anh = 'I' with someone younger."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_tinh_tien",
      "distractors": [
