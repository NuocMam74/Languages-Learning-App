  "title": {
    "fr": "Từ chối khéo",
    "en": "Declining gracefully"
  },
  "goal": {
    "fr": "Refuser poliment une invitation.",
    "en": "Politely decline an invitation."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u20.l05"
  ],
  "concepts": [
    "s_b_de_bua_khac",
    "s_b_tiec_qua",
