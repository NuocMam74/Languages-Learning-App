      "explain": {
        "fr": "lúc + heure.",
        "en": "lúc + time."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_ruoi",
      "explain": {
        "fr": "rưỡi : ngã, comme un hỏi au Sud.",
        "en": "rưỡi: ngã, like hỏi in the South."
