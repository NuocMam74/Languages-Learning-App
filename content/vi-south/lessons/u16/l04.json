      "explain": {
        "fr": "uống thuốc : prendre un médicament.",
        "en": "uống thuốc: take medicine."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_ngay_may_lan",
      "explain": {
        "fr": "mấy monte, lần descend.",
        "en": "mấy rises, lần falls."
      }
