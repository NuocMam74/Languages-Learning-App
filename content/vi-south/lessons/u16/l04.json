      "explain": {
        "fr": "thuốc monte. thước : la règle.",
        "en": "thuốc rises. thước: ruler."
      }
    },
    {
      "type": "build_sentence",
      "target": "Chị bán cho em thuốc nhức đầu.",
      "tokens": [
        "Chị",
        "bán",
        "cho",
        "em",
        "thuốc",
        "nhức đầu",
        "bệnh"
      ],
      "translation": {
        "fr": "Vends-moi un médicament contre le mal de tête. (à une femme un peu plus âgée)",
        "en": "Could I have something for a headache? (to a slightly older woman)"
      },
      "explain": {
        "fr": "thuốc + symptôme : médicament contre…",
        "en": "thuốc + symptom: medicine for…"
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_ngay_may_lan",
      "distractors": [
        "Ngày uống mấy ly?",
        "Ngày mai mấy lần?"
      ],
      "explain": {
        "fr": "mấy lần : combien de fois.",
        "en": "mấy lần: how many times."
      }
    },
    {
      "type": "build_sentence",
      "target": "Ngày uống mấy lần?",
      "tokens": [
        "Ngày",
        "uống",
        "mấy",
        "lần",
        "bao lâu"
      ],
      "translation": {
        "fr": "Combien de fois par jour ?",
        "en": "How many times a day?"
      },
      "explain": {
        "fr": "Ngày… mấy lần : par jour.",
        "en": "Ngày… mấy lần: per day."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_uong_thuoc",
      "distractors": [
