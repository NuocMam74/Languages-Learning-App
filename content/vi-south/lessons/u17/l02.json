      ],
      "explain": {
        "fr": "lầu hai : le deuxième étage.",
        "en": "lầu hai: second floor."
      }
    },
    {
      "type": "build_sentence",
      "target": "Nhà em ở trong hẻm, lầu hai.",
      "tokens": [
        "Nhà",
        "em",
        "ở",
        "trong",
        "hẻm",
        "lầu",
        "hai",
        "lâu"
      ],
      "translation": {
        "fr": "J'habite dans une ruelle, au deuxième étage.",
        "en": "I live down an alley, on the second floor."
      },
      "explain": {
        "fr": "Adresse du Sud : hẻm, puis lầu.",
        "en": "A southern address: hẻm, then lầu."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_tang_tret",
      "distractors": [
