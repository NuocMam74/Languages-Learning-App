        "tâng trệt"
      ],
      "explain": {
        "fr": "tầng trệt : le rez-de-chaussée.",
        "en": "tầng trệt: ground floor."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_alley",
      "explain": {
        "fr": "Sud : hẻm ; Nord : ngõ.",
        "en": "South: hẻm; North: ngõ."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_o_lau_hai",
      "explain": {
        "fr": "lầu descend, hai reste plat.",
        "en": "lầu falls, hai stays level."
      }
    }
