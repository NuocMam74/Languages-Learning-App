        "c_lau_floor",
        "c_lau_long",
        "c_lau_hotpot"
      ],
      "explain": {
        "fr": "lầu descend : l'étage. lâu plat : longtemps. lẩu plonge : la fondue.",
        "en": "lầu falls: floor. lâu level: long time. lẩu dips: hot pot."
      }
    },
    {
      "type": "tone_produce",
      "concept": "c_lau_floor",
      "explain": {
        "fr": "lầu : descend doucement (huyền).",
        "en": "lầu: falls gently (huyền)."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_o_lau_hai",
      "distractors": [
