  "title": {
    "fr": "Lầu, hẻm",
    "en": "Floors and alleys"
  },
  "goal": {
    "fr": "Dire à quel étage et dans quelle ruelle tu habites.",
    "en": "Say which floor and alley you live in."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u17.l01"
  ],
  "concepts": [
    "c_lau_floor",
    "c_lau_long",
    "c_lau_hotpot",
    "c_tang_tret",
    "s_o_lau_hai",
    "c_phong",
    "c_nha_house"
  ],
  "steps": [
    {
      "type": "listen_pick_image",
      "concept": "c_lau_floor",
      "distractors": [
        "c_phong",
        "c_nha_house"
      ],
      "explain": {
        "fr": "lầu : l'étage.",
        "en": "lầu: floor, storey."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_lau_tang"
    },
    {
      "type": "spot_the_south",
      "variant": "lv_floor",
      "explain": {
        "fr": "Sud : lầu ; Nord : tầng.",
        "en": "South: lầu; North: tầng."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
