{
  "$schema": "../../../schema/lesson.schema.json",
  "id": "vi-south.u24.l06",
  "unit": "vi-south.u24",
  "title": {
    "fr": "Bàn chuyện",
    "en": "Discussing"
  },
  "goal": {
    "fr": "Participer à une petite discussion entre amis.",
    "en": "Take part in a small discussion among friends."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u24.l05"
  ],
  "concepts": [
    "c_b_nghi_think",
    "c_b_khac",
    "s_b_tui_nghi_la",
    "s_b_moi_nguoi_thay_sao",
    "s_b_hue_nha",
    "c_moi_nguoi",
    "s_b_tai_sao_vay",
    "s_b_tai_vi_ket_xe",
    "c_b_tai_sao",
    "c_b_nen",
    "c_b_tai_vi",
    "s_b_kha_ngon"
  ],
  "steps": [
    {
      "type": "listen_pick_text",
      "concept": "s_b_tui_nghi_la",
      "distractors": [
        "Tui nghĩ là anh đúng.",
        "Tui nghĩ là chị sai."
      ],
      "explain": {
        "fr": "tui nghĩ là : je pense que.",
        "en": "tui nghĩ là: I think that."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_b_ban_tron"
    },
    {
      "type": "tone_identify",
      "concept": "c_b_nghi_think",
      "explain": {
        "fr": "nghĩ : ngã. Au Sud, il sonne comme nghỉ (se reposer) : le contexte tranche.",
        "en": "nghĩ: ngã. In the South it sounds like nghỉ (to rest): context decides."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_b_khac",
      "distractors": [
        "khắc",
        "khạc"
      ],
      "explain": {
        "fr": "khác monte : différent.",
        "en": "khác rises: different."
      }
    },
    {
      "type": "build_sentence",
      "target": "Tui nghĩ là chị đúng.",
      "tokens": [
        "Tui",
        "nghĩ",
        "là",
        "chị",
        "đúng",
        "đụng"
      ],
      "translation": {
        "fr": "Je pense que tu as raison.",
        "en": "I think you're right."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_b_moi_nguoi_thay_sao",
      "distractors": [
        "Mọi người thấy vui hông?",
        "Anh thấy sao?"
      ],
      "explain": {
        "fr": "mọi người : tout le monde.",
        "en": "mọi người: everyone."
      }
    },
    {
      "type": "dialogue_choice",
      "situation": {
        "fr": "Avec des collègues, vous choisissez où déjeuner.",
        "en": "With colleagues, you're picking a lunch spot."
      },
      "turns": [
        {
          "id": "t1",
          "vi": "Trưa nay mình ăn cơm tấm hay hủ tiếu?",
          "translation": {
            "fr": "Ce midi, cơm tấm ou hủ tiếu ?",
            "en": "Cơm tấm or hủ tiếu for lunch?"
          },
          "replies": [
            {
              "id": "r1a",
              "vi": "Theo tui, quán cơm tấm gần đây ngon hơn.",
              "next": "t2",
              "best": true,
              "feedback": {
                "fr": "« Theo tui » = à mon avis : la formule du Sud.",
                "en": "'Theo tui' = in my view: the Southern formula."
              }
            },
            {
              "id": "r1b",
              "vi": "Sao cũng được.",
              "next": "t2",
              "feedback": {
                "fr": "Ne rien dire, c'est laisser les autres décider pour toi.",
                "en": "Saying nothing means letting others decide for you."
              }
            }
          ]
        },
        {
          "id": "t2",
          "vi": "Ủa, quán đó hơi mắc mà.",
          "translation": {
            "fr": "Ah, mais ce resto est un peu cher.",
            "en": "Hmm, that place is a bit pricey though."
          },
          "replies": [
            {
              "id": "r2a",
              "vi": "Hơi mắc, nhưng mà ngon.",
              "next": "t3",
              "best": true,
              "feedback": {
                "fr": "Nuancer avec « hơi… nhưng mà… » : très naturel.",
                "en": "Qualifying with 'hơi… nhưng mà…': very natural."
              }
            },
            {
              "id": "r2b",
              "vi": "Sai rồi!",
              "next": "t3",
              "feedback": {
                "fr": "« Sai rồi » ferme la discussion : trop brutal.",
                "en": "'Sai rồi' shuts the conversation down: too harsh."
              }
            },
            {
              "id": "r2c",
              "vi": "Ừ, vậy đi chỗ khác.",
              "next": "t3",
              "feedback": {
                "fr": "Tu abandonnes ton avis trop vite.",
                "en": "You drop your opinion too quickly."
              }
            }
          ]
        },
        {
          "id": "t3",
          "vi": "Vậy tụi mình ăn cơm tấm nha.",
          "translation": {
            "fr": "Alors on prend un cơm tấm.",
            "en": "Cơm tấm it is, then."
          },
          "replies": [
            {
              "id": "r3a",
              "vi": "Dạ, tui đồng ý.",
              "best": true,
              "feedback": {
                "fr": "« đồng ý » clôt proprement la discussion.",
                "en": "'đồng ý' closes the discussion cleanly."
              }
            },
            {
              "id": "r3b",
              "vi": "Chưa chắc.",
              "feedback": {
                "fr": "Après une décision, « chưa chắc » sème le doute pour rien.",
                "en": "Once it's decided, 'chưa chắc' just sows doubt."
              }
            }
          ]
        }
      ],
      "explain": {
        "fr": "Donner son avis au Sud : theo tui, puis une nuance, jamais un « sai rồi » sec.",
        "en": "Giving an opinion in the South: theo tui, then a qualifier, never a bare 'sai rồi'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_b_hue_nha",
      "distractors": [
        "Thôi, về nha!",
        "Thôi, huề hen!"
      ],
      "explain": {
        "fr": "huề : match nul (Sud).",
        "en": "huề: a draw (South)."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_b_moi_nguoi_thay_sao",
      "explain": {
        "fr": "mọi court, người descend, thấy monte, sao plat.",
        "en": "mọi short, người falls, thấy rises, sao level."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_moi_nguoi",
      "distractors": [
        "anh hai",
