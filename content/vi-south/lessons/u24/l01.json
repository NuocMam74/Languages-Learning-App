  "title": {
    "fr": "Theo tui",
    "en": "In my opinion"
  },
  "goal": {
    "fr": "Donner ton avis simplement et demander celui des autres.",
    "en": "Give your opinion simply and ask for others'."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u23.l08"
  ],
  "concepts": [
