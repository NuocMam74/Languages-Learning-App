    "s_b_anh_thay_sao",
    "c_hon"
  ],
  "steps": [
    {
      "type": "listen_pick_text",
      "concept": "s_b_theo_tui_ngon",
      "distractors": [
        "Theo tui, quán này mắc hơn.",
        "Theo chị, quán này ngon hơn."
      ],
      "explain": {
        "fr": "theo tui : à mon avis ; theo chị : selon toi.",
        "en": "theo tui: in my view; theo chị: in your view."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_b_anh_thay_sao"
    },
    {
      "type": "listen_pick_text",
      "concept": "c_b_theo",
      "distractors": [
        "thèo",
        "thẹo"
      ],
      "explain": {
        "fr": "theo, plat : selon.",
        "en": "theo, level: according to."
      }
    },
    {
      "type": "build_sentence",
      "target": "Theo tui, quán này ngon hơn.",
      "tokens": [
        "Theo tui",
        "quán này",
        "ngon",
        "hơn",
        "hơi"
      ],
      "translation": {
        "fr": "À mon avis, ce resto est meilleur.",
        "en": "In my opinion, this place is better."
      },
      "explain": {
        "fr": "adjectif + hơn : plus… (que).",
        "en": "adjective + hơn: more… (than)."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_b_anh_thay_sao",
      "distractors": [
        "Chị thấy sao?",
        "Anh thấy hông?"
      ],
      "explain": {
        "fr": "thấy sao : qu'en penses-tu ?",
        "en": "thấy sao: what do you think?"
      }
    },
    {
      "type": "build_sentence",
      "target": "Anh thấy sao?",
      "tokens": [
        "Anh",
        "thấy",
        "sao",
        "sau"
      ],
      "translation": {
        "fr": "Qu'en penses-tu ?",
        "en": "What do you think?"
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_hon",
      "explain": {
        "fr": "hơn : ngang.",
        "en": "hơn: ngang."
      }
    },
    {
      "type": "fill_gap",
      "text": "Theo tui, quán này ngon ___.",
      "answer": "hơn",
      "options": [
        "hơn",
        "hờn",
        "hớn"
      ],
      "translation": {
        "fr": "À mon avis, ce resto est meilleur.",
        "en": "In my view this place is better."
      },
      "explain": {
        "fr": "hơn après l'adjectif = plus… que. hờn = bouder, hớn (hở) = tout joyeux.",
        "en": "hơn after an adjective = more… than. hờn = to sulk, hớn (hở) = beaming."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_b_theo_tui_ngon",
      "explain": {
        "fr": "theo plat, này descend, hơn plat.",
        "en": "theo level, này falls, hơn level."
      }
    },
    {
      "type": "game",
      "game": "cho_noi",
      "conceptPool": "lesson"
    }
  ],
