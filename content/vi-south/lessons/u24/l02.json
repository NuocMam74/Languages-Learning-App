      "concept": "s_b_dung_roi",
      "distractors": [
        "Đụng rồi!",
        "Sai rồi!"
      ],
      "explain": {
        "fr": "đúng rồi : c'est ça. đụng : heurter.",
        "en": "đúng rồi: that's right. đụng: to bump."
