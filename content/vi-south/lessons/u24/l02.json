        "c_b_dung_bump"
      ],
      "explain": {
        "fr": "đúng monte : juste. đụng tombe court : heurter.",
        "en": "đúng rises: right. đụng drops short: to bump."
      }
    },
    {
      "type": "tone_produce",
      "concept": "c_b_dung_right",
      "explain": {
        "fr": "đúng : monte.",
        "en": "đúng: rise."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_b_sai",
      "distractors": [
        "sài",
        "sải"
      ],
      "explain": {
        "fr": "sai, plat : faux.",
        "en": "sai, level: wrong."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_b_khong_noi_khong"
    },
