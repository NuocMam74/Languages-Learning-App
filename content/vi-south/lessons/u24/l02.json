    },
    {
      "type": "listen_pick_text",
      "concept": "c_b_hay",
      "distractors": [
        "hày",
        "háy"
      ],
      "explain": {
        "fr": "hay, plat : ou ; intéressant.",
        "en": "hay, level: or; interesting."
      }
    },
