  "id": "vi-south.u24.l02",
  "unit": "vi-south.u24",
  "title": {
    "fr": "Đúng hay sai?",
    "en": "Right or wrong?"
  },
  "goal": {
    "fr": "Dire qu'une chose est juste ou fausse, avec tact.",
    "en": "Say something is right or wrong, tactfully."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u24.l01"
