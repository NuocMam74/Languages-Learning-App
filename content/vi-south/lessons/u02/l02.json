        "vui",
        "lắm",
        "gì"
      ],
      "translation": {
        "fr": "Je suis très content(e).",
        "en": "I'm very happy."
      },
      "explain": {
        "fr": "L'adjectif suit le sujet, sans verbe « être » : em vui.",
        "en": "The adjective follows the subject, no verb 'to be': em vui."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "c_dua_coconut",
      "explain": {
        "fr": "Commence par « y », puis laisse le ton descendre.",
