      "explain": {
        "fr": "sữa : le lait. Son ngã sonne comme un hỏi au Sud.",
        "en": "sữa: milk. Its ngã sounds like hỏi in the South."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_xa_far",
      "distractors": [
        "xà",
        "vui",
        "gì"
      ],
      "explain": {
        "fr": "xa, plat, avec un x doux : loin. xà descend.",
        "en": "xa, level, with a soft x: far. xà falls."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_sach",
      "explain": {
        "fr": "sách monte (sắc).",
        "en": "sách rises (sắc)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Em xin ly sữa.",
      "tokens": [
        "Em",
        "xin",
        "ly",
        "sữa",
        "xa"
      ],
      "translation": {
        "fr": "Je voudrais un verre de lait.",
        "en": "May I have a glass of milk?"
      },
      "explain": {
        "fr": "xin + chose = demander poliment. ly, c'est le verre au Sud.",
        "en": "xin + thing = ask politely. ly is 'glass' in the South."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_verre",
      "explain": {
        "fr": "Au Sud, un verre, c'est ly ; cốc est du Nord.",
        "en": "In the South a glass is ly; cốc is northern."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "c_sua_milk",
      "explain": {
        "fr": "Langue un peu recourbée pour s, puis ư lèvres étirées.",
