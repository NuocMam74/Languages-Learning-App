        "c_mua_rain"
      ],
      "explain": {
        "fr": "ngủ : ng au début, comme à la fin de « parking ».",
        "en": "ngủ: initial ng, like the end of 'sing'."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_o_at",
      "explain": {
        "fr": "ở porte le hỏi, qui au Sud se confond avec le ngã.",
        "en": "ở carries hỏi, which merges with ngã in the South."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_dau_where",
      "distractors": [
        "đầu",
        "xa",
        "trái"
      ],
      "explain": {
        "fr": "đâu est plat : « où ? ». đầu descend : la tête. dâu commence par « y ».",
        "en": "đâu is level: 'where?'. đầu falls: head. dâu starts with 'y'."
      }
    },
    {
      "type": "build_sentence",
      "target": "Anh đi đâu vậy?",
      "tokens": [
        "Anh",
        "đi",
        "đâu",
        "vậy",
        "ở"
      ],
      "translation": {
        "fr": "Tu vas où ? (à un homme un peu plus âgé)",
        "en": "Where are you going? (to a slightly older man)"
      },
      "explain": {
        "fr": "Le mot interrogatif reste en fin de phrase. vậy adoucit la question.",
        "en": "The question word stays at the end. vậy softens the question."
      }
    },
    {
      "type": "build_sentence",
      "target": "Em ở nhà.",
      "tokens": [
        "Em",
        "ở",
        "nhà",
        "đi"
      ],
      "translation": {
        "fr": "Je suis à la maison.",
        "en": "I'm at home."
      },
      "explain": {
        "fr": "ở = « être à, se trouver ». Pas d'article : ở nhà.",
        "en": "ở = 'to be at'. No article: ở nhà."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_tieng_viet",
      "explain": {
        "fr": "tiếng monte, Việt tombe court. En Telex : tieengs Vieetj.",
        "en": "tiếng rises, Việt drops short. In Telex: tieengs Vieetj."
      }
    },
