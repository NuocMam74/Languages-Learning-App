      "concept": "c_nha_house",
      "distractors": [
        "c_ngu_sleep",
        "c_cho_market"
      ],
      "explain": {
        "fr": "nhà : nh se dit comme « gn » dans « montagne ».",
        "en": "nhà: nh sounds like the 'ny' in 'canyon'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_di_go",
      "distractors": [
        "đì",
        "một",
        "bốn"
      ],
      "explain": {
        "fr": "đ barré : langue contre les dents. d sans barre se dit « y » au Sud.",
        "en": "Barred đ: tongue against the teeth. Plain d sounds like 'y' in the South."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_telex"
