        "c_trai_fruit"
      ],
      "explain": {
        "fr": "chè : au Sud, le dessert sucré en verre.",
        "en": "chè: in the South, the sweet dessert in a glass."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_troi",
      "explain": {
        "fr": "trời descend. Trời ơi ! : l'exclamation préférée du Sud.",
        "en": "trời falls. Trời ơi!: the South's favourite exclamation."
      }
    },
    {
      "type": "build_sentence",
      "target": "Chờ em chút nha.",
      "tokens": [
        "Chờ",
        "em",
        "chút",
        "nha",
        "chợ"
      ],
      "translation": {
        "fr": "Attends-moi un peu, d'accord ?",
        "en": "Wait for me a moment, okay?"
      },
      "explain": {
        "fr": "nha adoucit la demande, très Sud. chờ (attendre) n'est pas chợ (marché).",
        "en": "nha softens the request, very southern. chờ (wait) isn't chợ (market)."
      }
    },
