      "concept": "c_tra_tea",
      "distractors": [
        "c_che_dessert",
        "c_sua_milk"
      ],
      "explain": {
        "fr": "trà : le thé. Au Sud, tr se dit langue recourbée, différent de ch.",
        "en": "trà: tea. In the South, tr is said with a curled tongue, unlike ch."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
        "chợ",
        "chờ"
      ],
      "audioConcepts": [
        "c_cho_market",
        "c_cho_wait"
      ],
      "explain": {
        "fr": "chợ tombe court (le marché) ; chờ descend doucement (attendre).",
        "en": "chợ drops short (market); chờ falls gently (wait)."
      }
    },
    {
