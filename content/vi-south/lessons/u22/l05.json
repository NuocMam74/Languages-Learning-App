  "title": {
    "fr": "Lần đầu",
    "en": "The first time"
  },
  "goal": {
    "fr": "Raconter une première fois.",
    "en": "Tell about a first time."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u22.l04"
  ],
  "concepts": [
    "c_b_lan",
    "c_b_lan_dau",
