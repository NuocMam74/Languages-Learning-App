  "title": {
    "fr": "Hồi nhỏ",
    "en": "As a child"
  },
  "goal": {
    "fr": "Dire où tu vivais quand tu étais petit(e).",
    "en": "Say where you lived as a child."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u20.l08"
  ],
  "concepts": [
