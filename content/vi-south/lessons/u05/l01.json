      "explain": {
        "fr": "họ tombe court : le nom de famille. hồ descend : le lac.",
        "en": "họ drops short: family name. hồ falls: lake."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_gap",
      "explain": {
        "fr": "gặp tombe court (nặng) : rencontrer.",
