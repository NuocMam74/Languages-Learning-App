      "translation": {
        "fr": "Mon nom de famille est Nguyễn, mon prénom Lan.",
        "en": "My family name is Nguyễn, my given name Lan."
      },
      "explain": {
        "fr": "On dit tôi họ Nguyễn sans là ; tên là Lan, ou plus court, tên Lan.",
        "en": "You say tôi họ Nguyễn without là; tên là Lan, or just tên Lan."
      }
    },
