      "distractors": [
        "Chị tên gì?",
        "Anh ở đâu?"
      ],
      "explain": {
        "fr": "Anh tên gì ? : on commence par la personne à qui l'on parle.",
        "en": "Anh tên gì?: you start with the person you're talking to."
      }
    },
    {
