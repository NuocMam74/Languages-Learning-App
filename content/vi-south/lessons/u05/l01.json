      "explain": {
        "fr": "chị : une femme un peu plus âgée que toi.",
        "en": "chị: a woman a little older than you."
      }
    },
    {
      "type": "build_sentence",
      "target": "Tôi họ Nguyễn, tên là Lan.",
      "tokens": [
        "Tôi",
        "họ",
