  "title": {
    "fr": "Tên gì ? Les prénoms",
    "en": "Tên gì? Names"
  },
  "goal": {
    "fr": "Demander et donner ton nom, et saluer une nouvelle rencontre.",
    "en": "Ask and give your name, and greet someone new."
  },
