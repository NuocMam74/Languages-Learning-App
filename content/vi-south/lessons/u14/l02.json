      }
    },
    {
      "type": "listen_transcribe",
      "concept": "c_ghien",
      "explain": {
        "fr": "ghiền : forme du Sud (au Nord : nghiện).",
        "en": "ghiền: the Southern form (nghiện in the North)."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_ghet",
      "explain": {
        "fr": "ghét monte (sắc).",
        "en": "ghét rises (sắc)."
      }
    },
    {
      "type": "speak_repeat",
      "concept": "s_ghien_ca_phe",
      "explain": {
        "fr": "ghiền descend, cà descend, phê plat.",
        "en": "ghiền falls, cà falls, phê level."
      }
    }
  ],
