      "concept": "c_ghet",
      "distractors": [
        "ghế",
        "ghẹt"
      ],
      "explain": {
        "fr": "ghét monte : détester. ghế : la chaise.",
        "en": "ghét rises: to hate. ghế: chair."
      }
