  "title": {
    "fr": "Nội et ngoại",
    "en": "Nội and ngoại"
  },
  "goal": {
    "fr": "Distinguer les grands-parents du côté du père et de la mère.",
    "en": "Tell paternal from maternal grandparents."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u04.l02"
  ],
  "concepts": [
    "c_noi",
    "c_ngoai",
    "c_ong_ba",
    "s_ba_noi",
    "s_ong_ngoai",
    "c_que",
