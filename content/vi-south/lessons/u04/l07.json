  "title": {
    "fr": "Révision : la famille",
    "en": "Review: family"
  },
  "goal": {
    "fr": "Revoir les mots de la famille et les questions qui vont avec.",
    "en": "Go over family words and the questions that go with them."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
