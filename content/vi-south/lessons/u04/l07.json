  "steps": [
    {
      "type": "listen_pick_image",
      "concept": "c_chi_hai",
      "distractors": [
        "c_anh_hai",
        "c_em_ut"
      ],
      "explain": {
        "fr": "chị hai : la sœur aînée, au Sud.",
        "en": "chị hai: eldest sister, in the South."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_ong_ngoai",
      "distractors": [
        "ông nội",
        "ông ngoài"
