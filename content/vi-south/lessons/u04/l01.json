        "hải"
      ],
      "explain": {
        "fr": "hai, plat : deux, et le rang de l'aîné.",
        "en": "hai, level: two, and the eldest's rank."
      }
    },
    {
      "type": "spot_the_south",
      "variant": "lv_aine",
      "explain": {
        "fr": "Au Sud, l'aîné est anh hai ; au Nord, anh cả.",
        "en": "In the South the eldest is anh hai; in the North, anh cả."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_em_ut",
      "distractors": [
        "c_anh_hai",
        "c_chi_hai"
      ],
      "explain": {
        "fr": "em út : le petit dernier, la petite dernière.",
        "en": "em út: the youngest child."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_anh_ba",
      "distractors": [
        "anh hai",
        "anh tư"
