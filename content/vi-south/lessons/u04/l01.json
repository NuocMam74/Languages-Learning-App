      "explain": {
        "fr": "anh ba : le deuxième enfant, puisque l'aîné porte déjà le rang hai.",
        "en": "anh ba: the second child, since the eldest already holds rank hai."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_tu",
      "explain": {
        "fr": "tư est plat : pour le rang, on dit tư, pas bốn.",
