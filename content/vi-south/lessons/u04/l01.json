  "title": {
    "fr": "Anh hai, chị hai",
    "en": "Anh hai, chị hai"
  },
  "goal": {
    "fr": "Nommer frères et sœurs selon leur rang, à la manière du Sud.",
    "en": "Name siblings by birth rank, the southern way."
  },
