      "concept": "c_anh_hai",
      "distractors": [
        "c_chi_hai",
        "c_em_ut"
      ],
      "explain": {
        "fr": "anh hai : au Sud, l'aîné porte le rang « hai ».",
        "en": "anh hai: in the South, the eldest has rank 'hai'."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_anh_hai_south"
