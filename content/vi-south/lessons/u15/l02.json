  "title": {
    "fr": "Gọi lại",
    "en": "Calling back"
  },
  "goal": {
    "fr": "Dire que tu es occupé et que tu rappelles.",
    "en": "Say you're busy and will call back."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u15.l01"
  ],
  "concepts": [
