      "concept": "s_goi_lai_nha",
      "distractors": [
        "Mai em gọi lại nha.",
        "Lát em tới nha."
      ],
      "explain": {
        "fr": "gọi lại : rappeler. lát : tout à l'heure.",
        "en": "gọi lại: call back. lát: in a bit."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_lat_nua"
    },
    {
      "type": "listen_pick_text",
      "concept": "c_ban_busy",
      "distractors": [
        "bán",
        "bạn"
      ],
      "explain": {
        "fr": "bận : occupé. bán : vendre. bạn : ami.",
        "en": "bận: busy. bán: to sell. bạn: friend."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_lat",
      "explain": {
        "fr": "lát monte (sắc).",
        "en": "lát rises (sắc)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Em đang bận, lát em gọi lại nha.",
      "tokens": [
        "Em",
        "đang",
        "bận",
        "lát",
        "em",
        "gọi lại",
        "nha",
        "bán"
      ],
      "translation": {
        "fr": "Je suis occupé(e), je te rappelle tout à l'heure.",
        "en": "I'm busy, I'll call you back in a bit."
      },
      "explain": {
        "fr": "đang bận + lát gọi lại : la formule parfaite.",
        "en": "đang bận + lát gọi lại: the perfect line."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_em_dang_ban",
      "distractors": [
        "Em đang bán.",
        "Em hông bận."
      ],
      "explain": {
        "fr": "bận tombe court.",
        "en": "bận drops short."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_goi_lai",
      "distractors": [
        "gói lại",
        "chút xíu"
      ],
      "explain": {
        "fr": "gọi lại : rappeler. gói lại : remballer.",
        "en": "gọi lại: call back. gói lại: wrap up."
      }
    },
    {
      "type": "dialogue_choice",
      "situation": {
        "fr": "Tu appelles un collègue, mais quelqu'un d'autre décroche.",
        "en": "You call a colleague, but somebody else picks up."
      },
      "turns": [
        {
          "id": "t1",
          "vi": "Alô, em nghe.",
          "translation": {
            "fr": "Allô, oui ?",
            "en": "Hello, yes?"
          },
          "replies": [
            {
              "id": "r1a",
              "vi": "Alô, dạ cho em gặp anh Minh.",
              "next": "t2",
              "best": true,
              "feedback": {
                "fr": "« cho em gặp… » = passe-moi…",
                "en": "'cho em gặp…' = put me through to…"
              }
            },
            {
              "id": "r1b",
              "vi": "Anh Minh đâu?",
              "next": "t2",
              "feedback": {
                "fr": "Trop direct au téléphone avec un inconnu.",
                "en": "Too direct on the phone with a stranger."
              }
            }
          ]
        },
        {
          "id": "t2",
          "vi": "Dạ, anh Minh đang họp. Ai vậy ạ?",
          "translation": {
            "fr": "Minh est en réunion. C'est de la part de qui ?",
            "en": "Minh is in a meeting. Who's calling?"
          },
          "replies": [
            {
              "id": "r2a",
              "vi": "Dạ em là Marie, bên công ty Sài Gòn Xanh.",
              "next": "t3",
              "best": true,
              "feedback": {
                "fr": "On se présente et on dit « bên » + société.",
                "en": "You give your name and 'bên' + company."
              }
            },
            {
              "id": "r2b",
              "vi": "Marie.",
              "next": "t3",
              "feedback": {
                "fr": "Donne aussi d'où tu appelles.",
                "en": "Say where you're calling from too."
              }
            }
          ]
        },
        {
          "id": "t3",
          "vi": "Dạ, để em nhắn lại giùm chị nha.",
          "translation": {
            "fr": "Je lui laisserai le message.",
            "en": "I'll pass the message on."
          },
          "replies": [
            {
              "id": "r3a",
              "vi": "Dạ, cảm ơn em. Lát chị gọi lại.",
              "best": true,
              "feedback": {
                "fr": "Remercier et annoncer le rappel : parfait.",
                "en": "Thank and announce the callback: perfect."
              }
            },
            {
              "id": "r3b",
              "vi": "Ừ.",
              "feedback": {
                "fr": "Un simple « ừ » laisse une impression de froideur.",
                "en": "A bare 'ừ' comes across as cold."
              }
            }
          ]
        }
      ],
      "explain": {
        "fr": "Au téléphone, dạ et giùm font tout le travail.",
        "en": "On the phone, dạ and giùm do all the work."
      }
    },
    {
      "type": "game",
      "game": "cho_noi",
      "conceptPool": "lesson"
    },
