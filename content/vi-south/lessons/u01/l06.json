  "id": "vi-south.u01.l06",
  "unit": "vi-south.u01",
  "title": {
    "fr": "Cá, gà, cơm, nước",
    "en": "Cá, gà, cơm, nước"
  },
  "goal": {
    "fr": "Reconnaître tes premiers mots de cuisine grâce aux tons.",
    "en": "Recognise your first food words by their tones."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u01.l05"
  ],
  "concepts": [
    "c_ca_fish",
    "c_ca_eggplant",
    "c_ga_chicken",
    "c_ga_station",
    "c_com",
    "c_nuoc",
