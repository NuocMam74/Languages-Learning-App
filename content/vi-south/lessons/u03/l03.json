  "title": {
    "fr": "Cô, chú et con",
    "en": "Cô, chú and con"
  },
  "goal": {
    "fr": "Saluer une personne de l'âge de tes parents comme au Sud.",
    "en": "Greet someone your parents' age the southern way."
  },
