{
  "$schema": "../../../schema/lesson.schema.json",
  "id": "vi-south.u03.l09",
  "unit": "vi-south.u03",
  "kind": "unit_test",
  "title": {
    "fr": "Épreuve : pronoms et rapports d'âge",
    "en": "Test: pronouns and age"
  },
  "goal": {
    "fr": "Montrer que tu choisis le bon pronom selon l'âge.",
    "en": "Show you pick the right pronoun by age."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u03.l08"
  ],
  "concepts": [
    "c_co_aunt",
    "c_bac",
    "s_em_may_tuoi",
    "c_con",
    "c_con_and",
    "c_chi",
    "c_chi_she",
    "c_minh",
    "c_nho",
    "s_ai_vay",
    "c_tui_me",
    "c_tui"
  ],
  "steps": [
    {
      "type": "listen_pick_image",
      "concept": "c_co_aunt",
      "distractors": [
        "c_chi",
        "c_ba_grandma"
      ],
      "explain": {
        "fr": "cô : l'âge de tes parents.",
        "en": "cô: your parents' age."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_bac",
      "distractors": [
        "c_ong",
        "c_chu"
      ],
      "explain": {
        "fr": "bác : plus âgé que tes parents.",
        "en": "bác: older than your parents."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_em_may_tuoi",
      "distractors": [
        "Anh mấy tuổi?",
        "Chị mấy tuổi?"
      ],
      "explain": {
        "fr": "On demande l'âge à em, plus jeune.",
        "en": "You ask em, someone younger."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
        "con",
        "còn"
      ],
      "audioConcepts": [
        "c_con",
        "c_con_and"
      ],
      "explain": {
        "fr": "con plat, còn descend.",
        "en": "con level, còn falls."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
        "chị",
        "chỉ"
      ],
      "audioConcepts": [
        "c_chi",
        "c_chi_she"
      ],
      "explain": {
        "fr": "chị court, chỉ plonge.",
        "en": "chị short, chỉ dips."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_minh",
      "explain": {
        "fr": "mình descend (huyền).",
        "en": "mình falls (huyền)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Tôi tên là Lan.",
      "tokens": [
        "Tôi",
        "tên",
        "là",
        "Lan",
        "gì"
      ],
      "translation": {
        "fr": "Je m'appelle Lan.",
        "en": "My name is Lan."
      },
      "explain": {
        "fr": "tên là = « le nom est ».",
        "en": "tên là = 'the name is'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_nho",
      "distractors": [
        "nho",
        "mì",
        "tui"
      ],
      "explain": {
        "fr": "nhỏ : petit, jeune.",
        "en": "nhỏ: small, young."
      }
    },
    {
      "type": "build_sentence",
      "target": "Mời bác uống trà.",
      "tokens": [
        "Mời",
        "bác",
        "uống",
        "trà",
        "ăn"
      ],
      "translation": {
        "fr": "Je vous en prie, prenez du thé (à un aîné).",
        "en": "Please have some tea (to an elder)."
      },
      "explain": {
        "fr": "Mời en tête, puis l'aîné, puis l'action.",
        "en": "Mời first, then the elder, then the action."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_ai_vay",
      "distractors": [
        "Gì vậy?",
        "tiếng Việt"
      ],
      "explain": {
        "fr": "Ai vậy ? = « C'est qui ? ».",
        "en": "Ai vậy? = 'Who is it?'."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
        "tui",
        "tụi"
      ],
      "audioConcepts": [
        "c_tui_me",
        "c_tui"
      ],
      "explain": {
        "fr": "tui plat (moi), tụi court (pluriel).",
        "en": "tui level (me), tụi short (plural)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Ổng là ba tôi.",
      "tokens": [
        "Ổng",
        "là",
        "ba",
        "tôi",
        "bả"
      ],
      "translation": {
        "fr": "Lui, c'est mon père.",
        "en": "He's my dad."
      },
      "explain": {
        "fr": "ổng = ông ấy, à l'oral du Sud.",
        "en": "ổng = ông ấy, in southern speech."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_con",
      "distractors": [
        "còn",
        "không",
        "trời"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_con_and",
      "distractors": [
        "con",
        "cũng",
        "mốt"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_chi",
      "distractors": [
        "chỉ",
        "thưa",
        "bà"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_chi_she",
      "distractors": [
        "chị",
        "trẻ",
        "không"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_minh",
      "distractors": [
        "người",
        "sông",
        "mưa"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_tui_me",
      "distractors": [
        "tụi",
        "bò",
        "mưa"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_tui",
      "distractors": [
        "tui",
        "trà",
        "lăm"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_co_aunt",
      "distractors": [
        "cổ",
        "năm",
        "chợ"
      ]
    },
    {
      "type": "listen_pick_text",
      "concept": "c_bac",
      "distractors": [
        "chưa",
        "ổng",
        "bạn"
      ]
    },
    {
      "type": "listen_pick_image",
      "concept": "c_con",
      "distractors": [
        "c_chu",
        "c_xe",
        "c_che_dessert"
      ]
    },
    {
      "type": "listen_pick_image",
      "concept": "c_chi",
      "distractors": [
        "c_ngu_sleep",
        "c_con",
        "c_com"
      ]
    },
    {
      "type": "fill_gap",
      "text": "Dạ, con cảm ơn ___ ạ.",
      "answer": "cô",
      "options": [
        "cô",
        "cổ",
        "nha",
        "năm"
      ],
      "translation": {
        "fr": "Merci beaucoup (très poli, à une femme de l'âge de tes parents).",
        "en": "Thank you (very polite, to a woman your parents' age)."
      }
    }
  ],
  "review": {
    "srsIntroduce": []
  },
  "reviewed": false
}
