      "explain": {
        "fr": "tụi mình = « nous », toi compris, entre proches.",
        "en": "tụi mình = 'we', including you, among close ones."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_ai",
      "distractors": [
        "ải",
        "ái"
      ],
      "explain": {
        "fr": "ai est plat : « qui ? ».",
        "en": "ai is level: 'who?'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_ai_vay",
      "distractors": [
        "Ai đó?",
        "Gì vậy?"
      ],
      "explain": {
        "fr": "Ai vậy ? = « C'est qui ? ». vậy adoucit la question.",
        "en": "Ai vậy? = 'Who is it?'. vậy softens the question."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_vay",
      "explain": {
        "fr": "vậy tombe court (nặng) : « ainsi, alors ».",
        "en": "vậy drops short (nặng): 'so, then'."
      }
    },
