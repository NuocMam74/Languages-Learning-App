        "mình",
        "đi",
        "đâu",
        "ai"
      ],
      "translation": {
        "fr": "On va où ?",
        "en": "Where are we going?"
      },
      "explain": {
        "fr": "tụi + pronom forme le pluriel : tụi mình, tụi em.",
        "en": "tụi + pronoun makes a plural: tụi mình, tụi em."
      }
    },
    {
