        "c_tui"
      ],
      "explain": {
        "fr": "tui est plat (moi, familier) ; tụi tombe court (marque du pluriel).",
        "en": "tui is level (me, casual); tụi drops short (plural marker)."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_tui_minh",
      "distractors": [
        "tụi em",
        "tụi anh"
