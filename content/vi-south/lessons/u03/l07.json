  "title": {
    "fr": "Tụi mình, ai ?",
    "en": "Tụi mình, ai?"
  },
  "goal": {
    "fr": "Dire « nous » à la manière du Sud et demander qui c'est.",
    "en": "Say 'we' the southern way and ask who someone is."
  },
  "estimatedMinutes": 6,
  "prerequisites": [
    "vi-south.u03.l06"
