  "title": {
    "fr": "Révision : pronoms et âges",
    "en": "Review: pronouns and age"
  },
  "goal": {
    "fr": "Revoir comment s'adresser à chacun selon son âge.",
    "en": "Go over how to address each person by age."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u03.l07"
