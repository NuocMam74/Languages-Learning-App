        "fr": "bà descend (madame) ; bả plonge (elle, une femme âgée).",
        "en": "bà falls (madam); bả dips (her, an older woman)."
      }
    },
    {
      "type": "build_sentence",
      "target": "Ổng là ba tôi.",
      "tokens": [
        "Ổng",
        "là",
        "ba",
        "tôi",
        "bả"
      ],
      "translation": {
        "fr": "Lui, c'est mon père.",
        "en": "He's my dad."
      },
      "explain": {
        "fr": "ổng reprend ông ấy : on parle de lui, pas à lui.",
        "en": "ổng stands for ông ấy: talking about him, not to him."
      }
    },
