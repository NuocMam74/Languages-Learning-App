{
  "$schema": "../../../schema/lesson.schema.json",
  "id": "vi-south.u10.l03",
  "unit": "vi-south.u10",
  "title": {
    "fr": "Gần hay xa ? Près ou loin ?",
    "en": "Gần hay xa? Near or far?"
  },
  "goal": {
    "fr": "Demander si c'est loin et ce qu'il y a près d'ici.",
    "en": "Ask if it's far and what's nearby."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
    "vi-south.u10.l02"
  ],
  "concepts": [
    "c_gan",
    "s_co_xa_khong",
    "c_quan_ca_phe",
    "c_cay_xang",
    "s_gan_day",
    "c_cho_market",
    "c_cho_wait"
  ],
  "steps": [
    {
      "type": "listen_pick_text",
      "concept": "s_co_xa_khong",
      "distractors": [
        "Có gần không?",
        "Có mắc không?"
      ],
      "explain": {
        "fr": "Có xa không ? : c'est loin ?",
        "en": "Có xa không?: is it far?"
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_distance_minutes"
    },
    {
      "type": "listen_pick_text",
      "concept": "c_gan",
      "distractors": [
        "gân",
        "gắn"
      ],
      "explain": {
        "fr": "gần descend : près. gân, plat : le tendon.",
        "en": "gần falls: near. gân, level: tendon."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_quan_ca_phe",
      "distractors": [
        "c_cay_xang",
        "c_ngan_hang"
      ],
      "explain": {
        "fr": "quán cà phê : le café, l'endroit.",
        "en": "quán cà phê: café, the place."
      }
    },
    {
      "type": "tone_minimal_pair",
      "pair": [
        "chợ",
        "chờ"
      ],
      "audioConcepts": [
        "c_cho_market",
        "c_cho_wait"
      ],
      "explain": {
        "fr": "chợ tombe court : le marché. chờ descend : attendre.",
        "en": "chợ drops short: market. chờ falls: to wait."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_cay_xang",
      "distractors": [
        "c_quan_ca_phe",
        "c_benh_vien"
      ],
      "explain": {
        "fr": "cây xăng : la station-service.",
        "en": "cây xăng: petrol station."
      }
    },
    {
      "type": "build_sentence",
      "target": "Gần đây có chợ không?",
      "tokens": [
        "Gần đây",
        "có",
        "chợ",
        "không",
        "xa"
      ],
      "translation": {
        "fr": "Il y a un marché près d'ici ?",
        "en": "Is there a market nearby?"
      },
      "explain": {
        "fr": "Gần đây có… không ? : « y a-t-il… près d'ici ? ».",
        "en": "Gần đây có… không?: 'is there… nearby?'."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_gan_day",
      "distractors": [
        "gần đó",
        "xa đây"
      ],
      "explain": {
        "fr": "gần đây : près d'ici. gần đó : près de là.",
        "en": "gần đây: near here. gần đó: near there."
      }
    },
    {
      "type": "build_sentence",
      "target": "Không xa lắm.",
      "tokens": [
        "Không",
        "xa",
        "lắm",
        "gần"
      ],
      "translation": {
        "fr": "Pas très loin.",
        "en": "Not very far."
      },
      "explain": {
        "fr": "không … lắm : « pas très ».",
        "en": "không … lắm: 'not very'."
      }
    },
    {
      "type": "game",
      "game": "cho_noi",
      "conceptPool": "lesson"
    }
  ],
  "review": {
    "srsIntroduce": [
      "c_gan",
      "s_co_xa_khong",
      "c_quan_ca_phe",
      "c_cay_xang",
      "s_gan_day"
    ]
  },
  "reviewed": false
}
