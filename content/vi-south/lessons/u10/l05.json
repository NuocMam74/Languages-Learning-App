      "concept": "c_hem",
      "distractors": [
        "hèm",
        "hém"
      ],
      "explain": {
        "fr": "hẻm plonge : la ruelle.",
        "en": "hẻm dips: alley."
      }
    },
    {
      "type": "culture_card",
      "ref": "cc_hem_address"
    },
    {
      "type": "spot_the_south",
      "variant": "lv_alley",
      "explain": {
        "fr": "Sud : hẻm ; Nord : ngõ.",
        "en": "South: hẻm; North: ngõ."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_duong_street",
      "distractors": [
