      "explain": {
        "fr": "đường descend : la rue (et le sucre !).",
        "en": "đường falls: street (and sugar!)."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_quan_district",
      "explain": {
        "fr": "quận tombe court (nặng) : l'arrondissement.",
        "en": "quận drops short (nặng): district."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "c_dia_chi",
      "distractors": [
        "địa chì",
        "dịa chỉ"
