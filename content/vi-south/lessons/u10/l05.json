  "title": {
    "fr": "Đường, hẻm : les adresses",
    "en": "Streets, alleys: addresses"
  },
  "goal": {
    "fr": "Comprendre et donner une adresse à Saïgon.",
    "en": "Understand and give a Saigon address."
  },
  "estimatedMinutes": 5,
  "prerequisites": [
