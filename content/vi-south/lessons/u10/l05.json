        "Nhà",
        "tôi",
        "ở",
        "hẻm",
        "năm mươi",
        "đường",
        "Lê Lợi",
        "quận"
      ],
      "translation": {
        "fr": "J'habite ruelle 50, rue Lê Lợi.",
        "en": "I live in alley 50, Lê Lợi street."
      },
      "explain": {
        "fr": "Du plus petit au plus grand : hẻm, puis đường, puis quận.",
        "en": "From smallest to largest: hẻm, then đường, then quận."
      }
    },
    {
      "type": "listen_pick_text",
      "concept": "s_so_nha",
      "distractors": [
        "sổ nhà",
        "số nhỏ"
      ],
      "explain": {
        "fr": "số nhà : le numéro de la maison.",
        "en": "số nhà: house number."
      }
    },
    {
      "type": "build_sentence",
      "target": "Địa chỉ của anh là gì?",
      "tokens": [
        "Địa chỉ",
        "của",
        "anh",
        "là",
        "gì",
        "đâu"
      ],
      "translation": {
        "fr": "C'est quoi ton adresse ? (à un homme un peu plus âgé)",
        "en": "What's your address? (to a slightly older man)"
      },
      "explain": {
        "fr": "Pour une adresse : là gì ?",
        "en": "For an address: là gì?"
      }
    },
    {
