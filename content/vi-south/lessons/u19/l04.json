        "en": "I'd like to open an account."
      }
    },
    {
      "type": "listen_pick_image",
      "concept": "c_b_the",
      "distractors": [
        "c_tien",
        "c_b_ho_chieu"
      ],
      "explain": {
        "fr": "thẻ : la carte (bancaire).",
        "en": "thẻ: (bank) card."
      }
