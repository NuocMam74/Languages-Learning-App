        "chuyện khoản"
      ],
      "explain": {
        "fr": "chuyển khoản : le virement.",
        "en": "chuyển khoản: bank transfer."
      }
    },
    {
      "type": "build_sentence",
      "target": "Chị chuyển khoản cho em nha.",
      "tokens": [
        "Chị",
        "chuyển khoản",
        "cho",
        "em",
        "nha",
        "không"
      ],
      "translation": {
        "fr": "Paie-moi par virement, d'accord ? (à une femme un peu plus âgée)",
        "en": "Pay me by transfer, okay? (to a slightly older woman)"
