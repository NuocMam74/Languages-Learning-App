      "explain": {
        "fr": "rút tiền : retirer. gửi : déposer. đổi : changer.",
        "en": "rút tiền: withdraw. gửi: deposit. đổi: exchange."
      }
    },
    {
      "type": "tone_identify",
      "concept": "c_b_the",
      "explain": {
        "fr": "thẻ porte le hỏi.",
        "en": "thẻ carries hỏi."
      }
    },
